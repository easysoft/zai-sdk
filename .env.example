# API root including /v1/zai, or a server origin (the fixture adapter adds /v1/zai).
# Used only by pnpm test:live and examples/node.ts; SDK baseUrl requires API root.
TEST_ZAI_BASE_URL=https://zai.example.com/v1/zai
TEST_ZAI_APP_ID=your-app-id
TEST_ZAI_APP_KEY=your-app-key
TEST_ZAI_USER_ID=your-user-id
