{
  "name": "zai-sdk",
  "version": "0.1.0",
  "description": "Typed ZAI API SDK for browsers and Node.js, with token renewal and streaming.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./zai-openapi.json"
  },
  "files": [
    "dist",
    "docs/index.html",
    "zai-openapi.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easysoft/zai-sdk.git"
  },
  "scripts": {
    "generate:api": "tsx scripts/generate-api.ts",
    "check:api": "tsx scripts/generate-api.ts --check",
    "docs:build": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsx scripts/build.ts",
    "prepack": "pnpm check:api && pnpm build && pnpm docs:build",
    "lint": "eslint .",
    "test": "vitest run --project unit && pnpm test:browser",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "pnpm build && playwright test",
    "test:live": "node --env-file=.env.local --import tsx --test tests/live.test.ts",
    "check:package": "tsx scripts/check-package.ts",
    "check": "pnpm check:api && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:browser && pnpm check:package"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "eventsource-parser": "^3.1.1",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "highlight.js": "^11.12.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
